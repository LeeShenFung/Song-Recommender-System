# Raw datasets -- too large for GitHub (User Listening History.csv is 602MB,
# exceeds GitHub's 100MB per-file limit) and not needed to run the app since
# artifacts/ already contains everything pre-computed.
# Only needed locally if you want to re-run src/preprocess.py.
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Streamlit
.streamlit/

# OS junk
.DS_Store
Thumbs.db
